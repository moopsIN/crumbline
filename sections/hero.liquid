{% comment %}
  Homepage hero (Cute): copy built from theme blocks on one side, and on the
  other a single photo in a plain or market-stall awning frame (the LCP
  image), with an optional rotating stamp badge, a "Today's bake" ticket
  linking to a product, and two speech bubbles (shown only when Theme
  settings → Decorations is on). Image side, focus, frame shape and phone
  order are section settings.
{% endcomment %}

{%- liquid
  assign product = section.settings.ticket_product
  assign bubble_1 = section.settings.bubble_1
  assign bubble_2 = section.settings.bubble_2
  assign aspect_ratio = section.settings.aspect_ratio
  if aspect_ratio == 'natural'
    assign aspect_ratio = ''
  endif
-%}

<div class="hero hero--image-{{ section.settings.image_position }} hero--phone-{{ section.settings.mobile_order }}-first full-width" {% render 'section-attributes' %}>
  <div class="hero__inner">
    <div class="hero__copy">
      {% content_for 'blocks' %}
    </div>

    <div class="hero__media">
      {%- comment -%} Only the first section loads its image at high priority; section.index is nil in the editor, which counts as first. {%- endcomment -%}
      {%- liquid
        assign is_first = false
        unless section.index > 1
          assign is_first = true
        endunless
      -%}
      {% render 'media-frame',
        image: section.settings.image,
        style: section.settings.media_style,
        sunburst: section.settings.sunburst,
        fit: section.settings.image_fit,
        focus: section.settings.image_focus,
        aspect_ratio: aspect_ratio,
        sizes: '(min-width: 900px) 500px, 92vw',
        priority: is_first
      %}

      {%- if section.settings.stamp_text != blank -%}
        {% render 'stamp-badge', text: section.settings.stamp_text, icon: section.settings.stamp_icon, id: section.id, class: 'hero__stamp' %}
      {%- endif -%}

      {%- if product != blank -%}
        <a href="{{ product.url }}" class="hero__ticket">
          <span class="hero__ticket-kicker mono">{{ section.settings.ticket_label | escape }}</span>
          <strong class="hero__ticket-title">{{ product.title | escape }}</strong>
          {%- if section.settings.ticket_show_price -%}
            <span class="hero__ticket-price mono">{{ product.price | money }} <span aria-hidden="true">→</span></span>
          {%- endif -%}
        </a>
      {%- endif -%}

      {% render 'speech-bubble', text: bubble_1, hand: section.settings.bubble_1_hand, class: 'hero__bubble hero__bubble--one' %}
      {% render 'speech-bubble', text: bubble_2, hand: section.settings.bubble_2_hand, tail: 'end', class: 'hero__bubble hero__bubble--two' %}
    </div>
  </div>
</div>

{% stylesheet %}
  @layer components {
    .hero {
      padding-block: calc(var(--section-padding-block) * var(--section-pad, 1) * 0.6);
      overflow-x: clip;
    }

    .hero__inner {
      display: grid;
      gap: clamp(2rem, 1rem + 3vw, 4rem);
      align-items: center;
      max-inline-size: var(--content-max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .hero__copy {
      display: grid;
      gap: var(--space-s);
      max-inline-size: 40rem;
    }

    .hero__media {
      position: relative;
      justify-self: center;
      inline-size: min(100%, 500px);
      container-type: inline-size;
    }

    .hero__media .hero__stamp {
      position: absolute;
      z-index: 2;
      inset-block-start: 0;
      inset-inline-end: 0;
    }

    .hero__ticket {
      position: absolute;
      z-index: 2;
      inset-inline-start: 0;
      inset-block-end: 9%;
      display: grid;
      gap: 0.1rem;
      padding: 0.8rem 1.3rem 0.85rem;
      border: var(--border-ink);
      border-radius: var(--radius-s);
      background-color: var(--color-surface);
      color: var(--color-ink);
      text-decoration: none;
      box-shadow: var(--shadow-hard);
      rotate: -5deg;
      transition:
        rotate 500ms var(--ease-bounce),
        translate 500ms var(--ease-bounce);
    }

    .hero__ticket:hover {
      rotate: 0deg;
      translate: 0 -4px;
    }

    .hero__ticket-kicker {
      color: var(--color-ink-muted);
    }

    .hero__ticket-title {
      font-family: var(--font-display);
      font-size: 1.2rem;
      line-height: 1.15;
    }

    .hero__ticket-price {
      color: var(--color-ink-muted);
    }

    .hero__bubble {
      position: absolute;
      z-index: 3;
    }

    .hero__bubble--one {
      inset-block-start: 22%;
      inset-inline-start: 2%;
      rotate: -6deg;
    }

    .hero__bubble--two {
      inset-block-end: 26%;
      inset-inline-end: 0;
      rotate: 4deg;
    }

    @media (max-width: 56.24rem) {
      .hero--phone-image-first .hero__media {
        order: -1;
      }
    }

    @media (min-width: 56.25rem) {
      .hero__inner {
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      }

      .hero--image-left .hero__inner {
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      }

      .hero--image-left .hero__media {
        order: -1;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "class": "hero-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.image",
      "info": "t:sections.hero.image_info"
    },
    {
      "type": "select",
      "id": "media_style",
      "label": "t:sections.hero.media_style",
      "options": [
        {
          "value": "awning",
          "label": "t:blocks.image.frame_awning"
        },
        {
          "value": "plain",
          "label": "t:blocks.image.frame_plain"
        }
      ],
      "default": "awning"
    },
    {
      "type": "checkbox",
      "id": "sunburst",
      "label": "t:blocks.image.sunburst",
      "default": true,
      "visible_if": "{{ section.settings.media_style == 'awning' }}"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.hero.image_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:sections.hero.fit_cover"
        },
        {
          "value": "contain",
          "label": "t:sections.hero.fit_contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_focus",
      "label": "t:blocks.image.focus",
      "info": "t:blocks.image.focus_info",
      "options": [
        {
          "value": "center top",
          "label": "t:blocks.image.focus_top"
        },
        {
          "value": "center 20%",
          "label": "t:blocks.image.focus_upper"
        },
        {
          "value": "center",
          "label": "t:blocks.image.focus_center"
        },
        {
          "value": "center bottom",
          "label": "t:blocks.image.focus_bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.image_fit == 'cover' }}"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "t:blocks.image.aspect_ratio",
      "options": [
        {
          "value": "natural",
          "label": "t:blocks.image.aspect_natural"
        },
        {
          "value": "1 / 1",
          "label": "t:blocks.image.aspect_square"
        },
        {
          "value": "4 / 5",
          "label": "t:blocks.image.aspect_portrait"
        },
        {
          "value": "3 / 4",
          "label": "t:blocks.image.aspect_tall"
        },
        {
          "value": "4 / 3",
          "label": "t:blocks.image.aspect_landscape"
        }
      ],
      "default": "natural",
      "visible_if": "{{ section.settings.media_style == 'plain' }}"
    },
    {
      "type": "header",
      "content": "t:sections.shared.layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_with_text.position",
      "options": [
        {
          "value": "right",
          "label": "t:sections.image_with_text.right"
        },
        {
          "value": "left",
          "label": "t:sections.image_with_text.left"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "t:sections.hero.mobile_order",
      "options": [
        {
          "value": "text",
          "label": "t:sections.hero.mobile_text_first"
        },
        {
          "value": "image",
          "label": "t:sections.hero.mobile_image_first"
        }
      ],
      "default": "text"
    },
    {
      "type": "header",
      "content": "t:sections.hero.stamp_header"
    },
    {
      "type": "text",
      "id": "stamp_text",
      "label": "t:sections.hero.stamp_text",
      "info": "t:sections.hero.stamp_text_info",
      "default": "Baked fresh to order"
    },
    {
      "type": "select",
      "id": "stamp_icon",
      "label": "t:blocks.chip.icon",
      "options": [
        {
          "value": "cake",
          "label": "t:blocks.chip.icon_cake"
        },
        {
          "value": "shop",
          "label": "t:blocks.chip.icon_shop"
        },
        {
          "value": "basket",
          "label": "t:blocks.chip.icon_basket"
        },
        {
          "value": "pin",
          "label": "t:blocks.chip.icon_pin"
        },
        {
          "value": "calendar",
          "label": "t:blocks.chip.icon_calendar"
        },
        {
          "value": "check",
          "label": "t:blocks.chip.icon_check"
        },
        {
          "value": "home",
          "label": "t:blocks.chip.icon_home"
        }
      ],
      "default": "cake",
      "visible_if": "{{ section.settings.stamp_text != blank }}"
    },
    {
      "type": "header",
      "content": "t:sections.hero.ticket_header"
    },
    {
      "type": "product",
      "id": "ticket_product",
      "label": "t:sections.hero.ticket_product",
      "info": "t:sections.hero.ticket_product_info"
    },
    {
      "type": "text",
      "id": "ticket_label",
      "label": "t:sections.hero.ticket_label",
      "default": "Today's bake",
      "visible_if": "{{ section.settings.ticket_product != blank }}"
    },
    {
      "type": "checkbox",
      "id": "ticket_show_price",
      "label": "t:sections.hero.ticket_show_price",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.hero.bubbles_header"
    },
    {
      "type": "paragraph",
      "content": "t:sections.hero.bubble_info"
    },
    {
      "type": "text",
      "id": "bubble_1",
      "label": "t:sections.hero.bubble_1",
      "default": "Fresh out of the oven!"
    },
    {
      "type": "checkbox",
      "id": "bubble_1_hand",
      "label": "t:sections.hero.bubble_hand",
      "default": true
    },
    {
      "type": "text",
      "id": "bubble_2",
      "label": "t:sections.hero.bubble_2"
    },
    {
      "type": "checkbox",
      "id": "bubble_2_hand",
      "label": "t:sections.hero.bubble_hand",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.shared.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:sections.shared.padding",
      "options": [
        {
          "value": "0",
          "label": "t:sections.shared.padding_none"
        },
        {
          "value": "0.5",
          "label": "t:sections.shared.padding_small"
        },
        {
          "value": "1",
          "label": "t:sections.shared.padding_default"
        },
        {
          "value": "1.5",
          "label": "t:sections.shared.padding_large"
        }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "eyebrow": "Baked to order",
            "heading": "Cakes baked <em>just for you</em>",
            "level": "h1",
            "size": "hero",
            "alignment": "left"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Small-batch cakes for birthdays, weddings and ordinary Tuesdays. Pick a size, a flavour and a day.</p>",
            "style": "lead",
            "alignment": "left"
          }
        },
        {
          "type": "group",
          "settings": {
            "direction": "row",
            "alignment": "flex-start",
            "gap": "s"
          },
          "blocks": [
            {
              "type": "button",
              "settings": {
                "label": "Order a cake",
                "link": "/collections/all",
                "style": "primary",
                "show_arrow": true
              }
            },
            {
              "type": "button",
              "settings": {
                "label": "Ask about a custom cake",
                "link": "/pages/contact",
                "style": "secondary",
                "show_arrow": false
              }
            }
          ]
        },
        {
          "type": "chip-row",
          "blocks": [
            {
              "type": "_chip",
              "settings": {
                "label": "Baked to order",
                "icon": "cake",
                "style": "label"
              }
            },
            {
              "type": "_chip",
              "settings": {
                "label": "Local pickup",
                "icon": "pin",
                "style": "label"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
