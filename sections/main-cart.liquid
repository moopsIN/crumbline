{% comment %}
  The /cart page: heading and the shared cart body (lines, note, notice
  reminder, totals, checkout and express checkout). Works without JS.
{% endcomment %}

<div class="main-cart full-width" {% render 'section-attributes' %}>
  <div class="main-cart__inner">
    <h1 class="main-cart__title">{{ 'cart.title' | t }}</h1>
    <div data-cart-region="page-body">
      {% render 'cart-body', context: 'page' %}
    </div>
  </div>
</div>

{% stylesheet %}
  @layer components {
    .main-cart {
      padding-block: calc(var(--section-padding-block) * var(--section-pad, 1));
    }

    .main-cart__inner {
      display: grid;
      gap: var(--space-m);
      max-inline-size: 48rem;
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .main-cart__title {
      font-size: var(--step-3);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "main-cart-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:sections.shared.padding",
      "options": [
        { "value": "0", "label": "t:sections.shared.padding_none" },
        { "value": "0.5", "label": "t:sections.shared.padding_small" },
        { "value": "1", "label": "t:sections.shared.padding_default" },
        { "value": "1.5", "label": "t:sections.shared.padding_large" }
      ],
      "default": "1"
    }
  ],
  "enabled_on": {
    "templates": ["cart"]
  }
}
{% endschema %}
