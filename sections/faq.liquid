{% comment %}
  Frequently asked questions as <details> disclosures (keyboard and screen
  reader friendly without JS).
{% endcomment %}

<div class="faq full-width" {% render 'section-attributes' %}>
  <div class="faq__inner">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text %}
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            {{- block.settings.question | escape -}}
            <span class="faq__icon" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
          </summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  @layer components {
    .faq {
      padding-block: calc(var(--section-padding-block) * var(--section-pad, 1));
    }

    .faq__inner {
      max-inline-size: var(--content-max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .faq__list {
      max-inline-size: 48rem;
      border-block-start: var(--border-divider);
    }

    .faq__item {
      border-block-end: var(--border-divider);
    }

    .faq__question {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-block-size: 64px;
      font-family: var(--font-display);
      font-size: var(--step-1);
      font-weight: var(--font-display-weight);
      list-style: none;
      cursor: pointer;
    }

    .faq__question::-webkit-details-marker {
      display: none;
    }

    .faq__icon {
      display: grid;
      flex: none;
      place-items: center;
      inline-size: 36px;
      block-size: 36px;
      border: var(--border-ink);
      border-radius: 50%;
      background-color: var(--color-surface);
      transition: rotate var(--dur-base) var(--ease-out);
    }

    .faq__icon .icon {
      inline-size: 1rem;
      block-size: 1rem;
    }

    .faq__item[open] .faq__icon {
      rotate: 45deg;
      background-color: var(--color-highlight);
      color: var(--color-on-highlight);
    }

    .faq__answer {
      padding-block-end: 1.25rem;
      color: var(--color-ink-muted);
    }

    .faq__answer > * + * {
      margin-block-start: 0.75em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.faq.name",
  "class": "faq-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.shared.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.eyebrow",
      "default": "Good to know"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.heading",
      "info": "t:sections.shared.heading_info",
      "default": "Questions, <em>answered.</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.shared.text"
    },
    {
      "type": "header",
      "content": "t:sections.shared.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:sections.shared.padding",
      "options": [
        {
          "value": "0",
          "label": "t:sections.shared.padding_none"
        },
        {
          "value": "0.5",
          "label": "t:sections.shared.padding_small"
        },
        {
          "value": "1",
          "label": "t:sections.shared.padding_default"
        },
        {
          "value": "1.5",
          "label": "t:sections.shared.padding_large"
        }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.question",
          "default": "How much notice do you need?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.answer",
          "default": "<p>Most cakes need a few days' notice. You'll see the earliest date on each cake's page.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How much notice do you need?",
            "answer": "<p>Most cakes need a few days' notice. You'll see the earliest date on each cake's page.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you deliver?",
            "answer": "<p>Yes, locally. Choose delivery when you order and we'll confirm the charge.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can you make an allergy-friendly cake?",
            "answer": "<p>Ask us about your needs. Every cake lists its allergens, and our kitchen handles nuts, gluten, egg and dairy.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
