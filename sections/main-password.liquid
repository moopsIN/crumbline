{% comment %}
  Password page (store not open yet): logo or name, the shop's password
  message, an optional newsletter sign-up, and the storefront password
  form inside a <details> (opens without JS; open when there's an error).
{% endcomment %}

<div class="main-password full-width" {% render 'section-attributes' %}>
  <div class="main-password__inner">
    <p class="main-password__brand">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag: widths: '240, 360, 480', sizes: '240px', alt: shop.name }}
      {%- else -%}
        {{ shop.name | escape }}
      {%- endif -%}
    </p>
    {%- assign stamp_text = 'password.stamp' | t -%}
    {% render 'stamp-badge', text: stamp_text, id: section.id %}
    <h1 class="main-password__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="main-password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', class: 'main-password__newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prelaunch">
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" role="status">{{ 'sections.footer.newsletter_success' | t }}</p>
        {%- else -%}
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'forms.email' | t }}</label>
          <div class="form-field main-password__field">
            <input id="PasswordNewsletter" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'forms.email_placeholder' | t }}">
          </div>
          {%- assign notify_label = 'password.notify' | t -%}
          {% render 'button', label: notify_label, type: 'submit' %}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- form 'storefront_password', class: 'main-password__unlock' -%}
      <details {% if form.errors %}open{% endif %}>
        <summary class="main-password__toggle">{{ 'password.enter_with' | t }}</summary>
        <div class="form-card">
          {%- if form.errors -%}
            <div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="form-field">
            <label for="StorePassword">{{ 'password.password' | t }}</label>
            <input id="StorePassword" type="password" name="password" autocomplete="current-password" required>
          </div>
          {%- assign enter_label = 'password.enter' | t -%}
          {% render 'button', label: enter_label, type: 'submit', icon: 'arrow-right' %}
        </div>
      </details>
    {%- endform -%}
    <p class="main-password__admin">{{ 'password.admin_html' | t: link: '/admin' }}</p>
  </div>
</div>

{% stylesheet %}
  @layer components {
    .main-password {
      min-block-size: 100svh;
      display: grid;
      place-items: center;
      padding: var(--space-xl) var(--gutter);
    }

    .main-password__inner {
      display: grid;
      justify-items: center;
      gap: var(--space-s);
      max-inline-size: 36rem;
      text-align: center;
    }

    .main-password__brand {
      margin: 0;
      font-family: var(--font-display);
      font-size: var(--step-2);
      font-weight: 700;
    }

    .main-password__title {
      font-size: var(--step-3);
    }

    .main-password__message {
      margin: 0;
      color: var(--color-ink-muted);
      font-size: var(--step-1);
    }

    .main-password__newsletter {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.6rem;
      inline-size: 100%;
    }

    .main-password__field {
      flex: 1 1 14rem;
    }

    .main-password__unlock {
      inline-size: 100%;
    }

    .main-password__toggle {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      font-weight: var(--font-body-weight-bold);
      text-decoration: underline 2px;
      text-underline-offset: 4px;
      cursor: pointer;
    }

    .main-password__unlock .form-card {
      margin-block-start: 1rem;
      text-align: start;
    }

    .main-password__admin {
      margin: 0;
      color: var(--color-ink-muted);
      font-size: 0.85rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "main-password-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.header.logo"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.heading",
      "default": "Something sweet is <em>coming soon</em>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.main_password.show_newsletter",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.shared.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
