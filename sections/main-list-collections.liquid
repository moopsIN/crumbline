{% comment %}
  The /collections page: a heading and a grid of collection cards, either
  every collection (paginated) or a hand-picked list.
{% endcomment %}

<div class="list-collections full-width" {% render 'section-attributes' %}>
  <div class="list-collections__inner">
    <h1 class="list-collections__title">{{ section.settings.heading | escape }}</h1>

    {%- if section.settings.collection_list != blank -%}
      <ul class="list-collections__grid" role="list">
        {%- for collection in section.settings.collection_list -%}
          <li>{% render 'collection-card', collection: collection, index: forloop.index %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- paginate collections by 24 -%}
        <ul class="list-collections__grid" role="list">
          {%- for collection in collections -%}
            <li>{% render 'collection-card', collection: collection, index: forloop.index %}</li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  @layer components {
    .list-collections {
      padding-block: calc(var(--section-padding-block) * var(--section-pad, 1));
    }

    .list-collections__inner {
      display: grid;
      gap: var(--space-l);
      max-inline-size: var(--content-max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .list-collections__grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
      gap: clamp(0.9rem, 0.6rem + 1vw, 1.4rem);
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.list_collections.name",
  "class": "list-collections-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.shared.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.list_collections.heading",
      "default": "Our cakes"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "t:sections.list_collections.collection_list",
      "info": "t:sections.list_collections.collection_list_info"
    },
    {
      "type": "header",
      "content": "t:sections.shared.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:sections.shared.padding",
      "options": [
        { "value": "0", "label": "t:sections.shared.padding_none" },
        { "value": "0.5", "label": "t:sections.shared.padding_small" },
        { "value": "1", "label": "t:sections.shared.padding_default" },
        { "value": "1.5", "label": "t:sections.shared.padding_large" }
      ],
      "default": "1"
    }
  ],
  "enabled_on": {
    "templates": ["list-collections"]
  }
}
{% endschema %}
