{% comment %}
  Create an account.
{% endcomment %}

<div class="main-register full-width page-pad" {% render 'section-attributes' %}>
  <div class="page-width customer">
    <h1 class="customer__title">{{ 'customers.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'form-card' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error" role="alert" tabindex="-1" data-focus-on-load>{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="form-field">
        <label for="RegisterFirst">{{ 'customers.first_name' | t }}</label>
        <input id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="form-field">
        <label for="RegisterLast">{{ 'customers.last_name' | t }}</label>
        <input id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="form-field">
        <label for="RegisterEmail">{{ 'forms.email' | t }}</label>
        <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="form-field">
        <label for="RegisterPassword">{{ 'customers.password' | t }}</label>
        <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      {%- assign create_label = 'customers.register.submit' | t -%}
      {% render 'button', label: create_label, type: 'submit', icon: 'arrow-right' %}
      <div class="customer__links"><a href="{{ routes.account_login_url }}">{{ 'customers.register.login' | t }}</a></div>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  @layer components {
    .customer {
      display: grid;
      gap: var(--space-m);
    }

    .customer__title {
      font-size: var(--step-3);
      text-align: center;
    }

    .customer__links {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      font-size: 0.9rem;
    }

    .customer__links a {
      text-decoration: underline 1px;
      text-underline-offset: 4px;
    }

    .customer__subtitle {
      font-size: var(--step-1);
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelector('[data-focus-on-load]')?.focus();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.main_register.name",
  "class": "customer-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.shared.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:sections.shared.padding",
      "options": [
        {
          "value": "0",
          "label": "t:sections.shared.padding_none"
        },
        {
          "value": "0.5",
          "label": "t:sections.shared.padding_small"
        },
        {
          "value": "1",
          "label": "t:sections.shared.padding_default"
        },
        {
          "value": "1.5",
          "label": "t:sections.shared.padding_large"
        }
      ],
      "default": "1"
    }
  ]
}
{% endschema %}
