{% comment %}
  Newsletter sign-up: heading, intro and an email field (Shopify customer
  form, tagged "newsletter") with success and error messages and an
  optional consent line.
{% endcomment %}

<div class="newsletter full-width" {% render 'section-attributes' %}>
  <div class="newsletter__inner">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, align: 'center' %}
    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__status" role="status">{% render 'icon', name: 'check' %}{{ 'sections.footer.newsletter_success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'forms.email' | t }}</label>
        <div class="newsletter__field">
          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ 'forms.email_placeholder' | t }}"
            {% if form.errors %}aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"{% endif %}
          >
          {%- assign subscribe_label = 'sections.footer.newsletter_submit' | t -%}
          {% render 'button', label: subscribe_label, type: 'submit' %}
        </div>
        {%- if form.errors -%}
          <p class="newsletter__status newsletter__status--error" id="NewsletterError-{{ section.id }}">
            {% render 'icon', name: 'alert' %}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.consent != blank -%}
        <p class="newsletter__consent">{{ section.settings.consent | escape }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  @layer components {
    .newsletter {
      padding-block: calc(var(--section-padding-block) * var(--section-pad, 1));
    }

    .newsletter__inner {
      max-inline-size: var(--content-max);
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .newsletter__form {
      display: grid;
      gap: 0.75rem;
      max-inline-size: 32rem;
      margin-inline: auto;
    }

    .newsletter__field {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .newsletter__field input {
      flex: 1 1 14rem;
      min-block-size: 54px;
      padding: 0.6rem 1.2rem;
      border: var(--border-ink);
      border-radius: var(--radius-pill);
      background-color: var(--color-surface-alt);
      color: var(--color-ink);
    }

    .newsletter__status {
      display: flex;
      justify-content: center;
      gap: 0.4rem;
      margin: 0;
      font-weight: var(--font-body-weight-bold);
    }

    .newsletter__status .icon {
      inline-size: 1.2rem;
      block-size: 1.2rem;
    }

    .newsletter__status--error {
      color: var(--color-error);
    }

    .newsletter__consent {
      margin: 0;
      color: var(--color-ink-muted);
      font-size: 0.85rem;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.shared.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.shared.eyebrow",
      "default": "Bake news"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.shared.heading",
      "info": "t:sections.shared.heading_info",
      "default": "Fresh bakes, <em>first.</em>"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.shared.text",
      "default": "New flavours and holiday order dates, now and then. No spam."
    },
    {
      "type": "text",
      "id": "consent",
      "label": "t:sections.newsletter.consent",
      "default": "You can unsubscribe at any time."
    },
    {
      "type": "header",
      "content": "t:sections.shared.style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.shared.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:sections.shared.padding",
      "options": [
        {
          "value": "0",
          "label": "t:sections.shared.padding_none"
        },
        {
          "value": "0.5",
          "label": "t:sections.shared.padding_small"
        },
        {
          "value": "1",
          "label": "t:sections.shared.padding_default"
        },
        {
          "value": "1.5",
          "label": "t:sections.shared.padding_large"
        }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
