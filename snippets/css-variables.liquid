{% doc %}
  Emits the theme's font faces and setting-driven CSS custom properties.

  Colour schemes come from the `color_schemes` setting group. Each scheme
  remaps the same `--color-*` properties under `[data-scheme="<id>"]`; the
  first scheme also applies to `:root`. Tokens derived from these colours
  (borders, shadows) are declared on `:root, [data-scheme]` in critical.css so
  they resolve against the scheme of the element they're used in.

  Font files: display 600 + italic 400, body 400 + 600, mono 400 + 500. The
  hand font is only declared here; components that use it load its face.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign display_italic = settings.type_display_font | font_modify: 'style', 'italic' | font_modify: 'weight', '400'
  assign body_bold = settings.type_body_font | font_modify: 'weight', '600'
  assign mono_medium = settings.type_mono_font | font_modify: 'weight', '500'

  assign button_radius = '999px'
  if settings.button_shape == 'rounded'
    assign button_radius = 'var(--radius-s)'
  endif

  assign button_shadow = '4px'
  unless settings.button_shadow
    assign button_shadow = '0px'
  endunless
-%}

{% style %}
  {{ settings.type_display_font | font_face: font_display: 'swap' }}
  {%- if display_italic %}{{ display_italic | font_face: font_display: 'swap' }}{% endif %}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {%- if body_bold %}{{ body_bold | font_face: font_display: 'swap' }}{% endif %}
  {{ settings.type_mono_font | font_face: font_display: 'swap' }}
  {%- if mono_medium %}{{ mono_medium | font_face: font_display: 'swap' }}{% endif %}

  :root {
    --font-display: {{ settings.type_display_font.family }}, {{ settings.type_display_font.fallback_families }};
    --font-display-weight: {{ settings.type_display_font.weight }};
    --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    --font-body-weight: {{ settings.type_body_font.weight }};
    --font-body-weight-bold: {% if body_bold %}{{ body_bold.weight }}{% else %}700{% endif %};
    --font-mono: {{ settings.type_mono_font.family }}, {{ settings.type_mono_font.fallback_families }};
    --font-mono-weight-medium: {% if mono_medium %}{{ mono_medium.weight }}{% else %}{{ settings.type_mono_font.weight }}{% endif %};
    --font-hand: {{ settings.type_hand_font.family }}, {{ settings.type_hand_font.fallback_families }};
    --font-scale: {{ settings.type_body_scale | divided_by: 100.0 }};

    --content-max: {{ settings.page_width }};
    --card-aspect: {{ settings.card_aspect }};
    --section-spacing-scale: {{ settings.section_spacing }};

    --button-radius: {{ button_radius }};
    --button-shadow-offset: {{ button_shadow }};
  }

  {% for scheme in settings.color_schemes %}
    {% if forloop.first %}:root,{% endif %}
    [data-scheme="{{ scheme.id }}"] {
      --color-bg: {{ scheme.settings.background }};
      --color-surface: {{ scheme.settings.surface }};
      --color-surface-alt: {{ scheme.settings.surface_alt }};
      --color-ink: {{ scheme.settings.text }};
      --color-ink-muted: {{ scheme.settings.text_muted }};
      --color-accent: {{ scheme.settings.accent }};
      --color-accent-text: {{ scheme.settings.accent_text }};
      --color-highlight: {{ scheme.settings.highlight }};
      --color-highlight-2: {{ scheme.settings.highlight_2 }};
      --color-button: {{ scheme.settings.button }};
      --color-button-label: {{ scheme.settings.button_label }};
      --color-button-secondary: {{ scheme.settings.secondary_button }};
      --color-button-secondary-label: {{ scheme.settings.secondary_button_label }};
    }
  {% endfor %}
{% endstyle %}
