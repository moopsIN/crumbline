{% doc %}
  Renders a collection card: image (the collection's own, else its first
  product's), title and product count. The whole card is one link.

  @param {collection} collection - The collection
  @param {string} [sizes] - `sizes` for the image
  @param {number} [index] - Position in the grid; picks the pastel placeholder ground
  @param {string} [heading_level] - `h2` (default) or `h3`

  @example
  {% render 'collection-card', collection: collection, index: forloop.index %}
{% enddoc %}

{%- liquid
  assign level = heading_level | default: 'h2'
  assign pastel = index | default: 1 | modulo: 5 | plus: 1
  assign sizes = sizes | default: '(min-width: 900px) 30vw, 50vw'
  assign image = collection.featured_image | default: collection.products.first.featured_media.preview_image
-%}

<article class="collection-card" style="--card-pastel: var(--color-pastel-{{ pastel }});">
  <div class="collection-card__media">
    {%- if image -%}
      {{
        image
        | image_url: width: 900
        | image_tag:
          widths: '360, 540, 720, 900',
          sizes: sizes,
          loading: 'lazy',
          alt: '',
          class: 'collection-card__image'
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'collection-card__image collection-card__placeholder' }}
    {%- endif -%}
  </div>
  <div class="collection-card__body">
    <{{ level }} class="collection-card__title">
      <a href="{{ collection.url }}" class="collection-card__link">{{ collection.title | escape }}</a>
    </{{ level }}>
    <p class="collection-card__count mono">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
  </div>
</article>

{% stylesheet %}
  @layer components {
    .collection-card {
      position: relative;
      display: flex;
      flex-direction: column;
      block-size: 100%;
      overflow: hidden;
      border: var(--border-ink);
      border-radius: var(--radius-m);
      background-color: var(--color-surface);
      transition:
        translate 450ms var(--ease-spring),
        box-shadow var(--dur-base) var(--ease-out);
    }

    .collection-card__media {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background-color: var(--card-pastel);
    }

    .collection-card__image {
      inline-size: 100%;
      block-size: 100%;
      object-fit: cover;
    }

    .collection-card__placeholder {
      fill: color-mix(in oklch, var(--color-on-highlight) 25%, transparent);
    }

    .collection-card__body {
      display: grid;
      gap: 0.25rem;
      padding: 0.9rem 1rem 1rem;
      border-block-start: var(--border-ink);
    }

    .collection-card__title {
      font-size: var(--step-1);
    }

    .collection-card__link {
      text-decoration: none;
    }

    .collection-card__link::after {
      content: '';
      position: absolute;
      inset: 0;
    }

    .collection-card__link:focus-visible {
      outline: none;
      box-shadow: none;
    }

    .collection-card:has(.collection-card__link:focus-visible) {
      outline: 3px solid var(--color-ink);
      outline-offset: 3px;
      box-shadow: 0 0 0 6px var(--color-accent);
    }

    .collection-card__count {
      margin: 0;
      color: var(--color-ink-muted);
    }

    @media (hover: hover) {
      .collection-card:hover {
        translate: -3px -3px;
        box-shadow: 7px 7px 0 var(--color-ink);
      }
    }

    @media (min-width: 45rem) {
      .collection-card {
        border-radius: var(--radius-l);
      }
    }
  }
{% endstylesheet %}
