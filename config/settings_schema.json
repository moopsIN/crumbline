  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_display_font",
        "label": "t:settings.typography.display_font",
        "info": "t:settings.typography.display_font_info",
        "default": "fraunces_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings.typography.body_font",
        "default": "dm_sans_n4"
