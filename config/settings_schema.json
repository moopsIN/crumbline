[
  {
    "name": "theme_info",
    "theme_name": "Crumbline",
    "theme_version": "0.1.0",
    "theme_author": "Moops Design",
    "theme_documentation_url": "https://github.com/moopsIN/crumbline/tree/main/docs",
    "theme_support_url": "https://github.com/moopsIN/crumbline/issues"
  },
  {
    "name": "t:settings.branding.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.branding.favicon",
        "info": "t:settings.branding.favicon_info"
      }
    ]
  },
  {
    "name": "t:settings.colors.name",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "header",
            "content": "t:settings.colors.header_surfaces"
          },
          {
            "type": "color",
            "id": "background",
            "label": "t:settings.colors.background",
            "default": "#F4ECDF"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "t:settings.colors.surface",
            "info": "t:settings.colors.surface_info",
            "default": "#FFFDF9"
          },
          {
            "type": "color",
            "id": "surface_alt",
            "label": "t:settings.colors.surface_alt",
            "info": "t:settings.colors.surface_alt_info",
            "default": "#FBF6EE"
          },
          {
            "type": "header",
            "content": "t:settings.colors.header_text"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings.colors.text",
            "info": "t:settings.colors.text_info",
            "default": "#1B1714"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "t:settings.colors.text_muted",
            "default": "#4A423B"
          },
          {
            "type": "header",
            "content": "t:settings.colors.header_accents"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:settings.colors.accent",
            "info": "t:settings.colors.accent_info",
            "default": "#FF8A3D"
          },
          {
            "type": "color",
            "id": "accent_text",
            "label": "t:settings.colors.accent_text",
            "info": "t:settings.colors.accent_text_info",
            "default": "#D9541A"
          },
          {
            "type": "color",
            "id": "highlight",
            "label": "t:settings.colors.highlight",
            "info": "t:settings.colors.highlight_info",
            "default": "#FFE08A"
          },
          {
            "type": "color",
            "id": "highlight_2",
            "label": "t:settings.colors.highlight_2",
            "info": "t:settings.colors.highlight_2_info",
            "default": "#FFC2CE"
          },
          {
            "type": "header",
            "content": "t:settings.colors.header_buttons"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings.colors.button",
            "default": "#1B1714"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings.colors.button_label",
            "default": "#F4ECDF"
          },
          {
            "type": "color",
            "id": "secondary_button",
            "label": "t:settings.colors.secondary_button",
            "default": "#FFFDF9"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:settings.colors.secondary_button_label",
            "default": "#1B1714"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "secondary_button",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "secondary_button_label",
          "links": "text",
          "icons": "text"
        }
      }
    ]
  },
  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_display_font",
        "label": "t:settings.typography.display_font",
        "info": "t:settings.typography.display_font_info",
        "default": "fraunces_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "t:settings.typography.body_font",
        "default": "dm_sans_n4"
      },
      {
        "type": "font_picker",
        "id": "type_mono_font",
        "label": "t:settings.typography.mono_font",
        "info": "t:settings.typography.mono_font_info",
        "default": "ibm_plex_mono_n4"
      },
      {
        "type": "font_picker",
        "id": "type_hand_font",
        "label": "t:settings.typography.hand_font",
        "info": "t:settings.typography.hand_font_info",
        "default": "caveat_n5"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "label": "t:settings.typography.body_scale",
        "min": 90,
        "max": 115,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "t:settings.layout.name",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "label": "t:settings.layout.page_width",
        "options": [
          {
            "value": "77.5rem",
            "label": "t:settings.layout.page_width_standard"
          },
          {
            "value": "90rem",
            "label": "t:settings.layout.page_width_wide"
          }
        ],
        "default": "77.5rem"
      },
      {
        "type": "select",
        "id": "section_spacing",
        "label": "t:settings.layout.section_spacing",
        "options": [
          {
            "value": "0.75",
            "label": "t:settings.layout.spacing_compact"
          },
          {
            "value": "1",
            "label": "t:settings.layout.spacing_default"
          },
          {
            "value": "1.25",
            "label": "t:settings.layout.spacing_roomy"
          }
        ],
        "default": "1"
      }
    ]
  },
  {
    "name": "t:settings.buttons.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "button_shadow",
        "label": "t:settings.buttons.shadow",
        "info": "t:settings.buttons.shadow_info",
        "default": true
      },
      {
        "type": "select",
        "id": "button_shape",
        "label": "t:settings.buttons.shape",
        "options": [
          {
            "value": "pill",
            "label": "t:settings.buttons.shape_pill"
          },
          {
            "value": "rounded",
            "label": "t:settings.buttons.shape_rounded"
          }
        ],
        "default": "pill"
      }
    ]
  },
  {
    "name": "t:settings.decorations.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "decorations_enabled",
        "label": "t:settings.decorations.enabled",
        "info": "t:settings.decorations.enabled_info",
        "default": false
      }
    ]
  }
]
