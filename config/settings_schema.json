          {
            "value": "1",
            "label": "t:settings.layout.spacing_default"
          },
          {
            "value": "1.25",
            "label": "t:settings.layout.spacing_roomy"
          }
        ],
        "default": "1"
      },
      {
        "type": "select",
        "id": "mobile_nav",
        "label": "t:settings.layout.mobile_nav",
