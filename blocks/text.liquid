{% doc %}
  Renders a block of rich text in one of three styles: body, lead (larger
  intro text) or micro (mono uppercase label).

  @example
  {% content_for 'block', type: 'text', id: 'intro' %}
{% enddoc %}

<div
  class="text-block text-block--{{ block.settings.style }} text-block--align-{{ block.settings.alignment }}"
  style="--text-align: {{ block.settings.alignment }};"
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% stylesheet %}
  @layer components {
    .text-block {
      max-inline-size: 65ch;
      text-align: var(--text-align);
    }

    .text-block--align-center {
      margin-inline: auto;
    }

    .text-block--align-right {
      margin-inline-start: auto;
    }

    .text-block > * + * {
      margin-block-start: 0.75em;
    }

    .text-block--lead {
      color: var(--color-ink-muted);
      font-size: var(--step-1);
      line-height: 1.45;
    }

    .text-block--micro {
      color: var(--color-ink-muted);
      font-family: var(--font-mono);
      font-size: max(0.8em, var(--text-micro));
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.text.name",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:blocks.text.text",
      "default": "<p>Tell people what makes your bakes special.</p>"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.text.style",
      "options": [{"value": "body", "label": "t:blocks.text.style_body"}, {"value": "lead", "label": "t:blocks.text.style_lead"}, {"value": "micro", "label": "t:blocks.text.style_micro"}],
      "default": "body"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:blocks.shared.alignment",
      "default": "left"
    }
  ],
  "presets": [{ "name": "t:blocks.text.name" }]
}
{% endschema %}
