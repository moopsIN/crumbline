{% doc %}
  Groups blocks in a row or a column with token-based gaps, so merchants can
  build layouts such as "two buttons side by side" without code. Rows wrap
  on narrow screens.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

<div
  class="group-block group-block--{{ block.settings.direction }}"
  style="--group-gap: var(--space-{{ block.settings.gap }}); --group-align: {{ block.settings.alignment }};"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  @layer components {
    .group-block {
      display: flex;
      gap: var(--group-gap);
      inline-size: 100%;
    }

    .group-block--row {
      flex-flow: row wrap;
      align-items: center;
      justify-content: var(--group-align);
    }

    .group-block--column {
      flex-direction: column;
      align-items: var(--group-align);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.group.name",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "t:blocks.group.direction",
      "options": [{"value": "column", "label": "t:blocks.group.direction_column"}, {"value": "row", "label": "t:blocks.group.direction_row"}],
      "default": "column"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:blocks.shared.alignment",
      "options": [{"value": "flex-start", "label": "t:blocks.shared.align_start"}, {"value": "center", "label": "t:blocks.shared.align_center"}, {"value": "flex-end", "label": "t:blocks.shared.align_end"}],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:blocks.group.gap",
      "options": [{"value": "2xs", "label": "t:blocks.spacer.size_2xs"}, {"value": "xs", "label": "t:blocks.spacer.size_xs"}, {"value": "s", "label": "t:blocks.spacer.size_s"}, {"value": "m", "label": "t:blocks.spacer.size_m"}, {"value": "l", "label": "t:blocks.spacer.size_l"}],
      "default": "s"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.group.preset_column",
      "category": "t:blocks.group.category",
      "settings": { "direction": "column" }
    },
    {
      "name": "t:blocks.group.preset_row",
      "category": "t:blocks.group.category",
      "settings": { "direction": "row" }
    }
  ]
}
{% endschema %}
