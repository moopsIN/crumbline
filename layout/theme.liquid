<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta name="theme-color" content="{{ settings.color_schemes.first.settings.background }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% # The display font sets the LCP heading on most pages, so fetch it early. %}
    {{ settings.type_display_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'components.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body data-scheme="{{ settings.color_schemes.first.id }}" data-mobile-nav="{{ settings.mobile_nav }}">
    <a class="skip-link" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'toast' %}
    {% render 'whatsapp-button', product_title: product.title %}
  </body>
</html>
