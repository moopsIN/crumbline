<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <meta name="theme-color" content="{{ settings.color_schemes.first.settings.background }}">
    {{ settings.type_display_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ content_for_header }}
  </head>

  <body data-scheme="{{ settings.color_schemes.first.id }}" data-mobile-nav="drawer">
    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
